{
  "name": "ops-command-centre",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @ops/api prisma migrate deploy",
    "db:seed": "pnpm --filter @ops/api db:seed",
    "demo": "pnpm --filter @ops/api demo:seed"
  }
}
